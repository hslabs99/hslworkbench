# Copy to .env.local — .env.local is gitignored (*.local)

# Required for Microsoft sign-in in the browser (Vite exposes VITE_* vars only)
VITE_MS_TENANT_ID=
VITE_MS_CLIENT_ID=
VITE_MS_REDIRECT_URI=http://localhost:5173/auth/microsoft/callback
# App Hosting: set VITE_MS_TENANT_ID and VITE_MS_CLIENT_ID in apphosting.yaml (BUILD).
# Redirect URI can be omitted on hosting — app uses {origin}/auth/microsoft/callback.
# Register that URI in Azure Entra → App registration → Authentication (SPA).

# Firebase — server only. Do NOT prefix with VITE_ (that would embed keys in the browser bundle).
# App Hosting: set the same FIREBASE_* variables in apphosting.yaml with availability RUNTIME.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# OpenAI — loaded from Google Secret Manager (openaiApiKey), not from this file.
# Local dev: gcloud auth application-default login
# Optional override only (normally leave unset):
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Marketing campaigns send via SendGrid (server only — do not prefix with VITE_).
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=
SENDGRID_TEST_RECIPIENT=

# Public origin for campaign tracking and unsubscribe links (hosted App Hosting URL).
# Unsubscribe always uses this domain, even when you send from local dev:
#   https://hslworkbench--hslworkbench.asia-southeast1.hosted.app/unsubscribe?you@example.com
# VITE_MAILING_PUBLIC_ORIGIN=https://hslworkbench--hslworkbench.asia-southeast1.hosted.app

# Optional — reserved for a future backend; not used by SPA sign-in today
MS_CLIENT_SECRET=

# CELGPS → Supabase migration (dev server only; see .env.celgps-migration.local)
# CELGPS_SUPABASE_PASSWORD=
